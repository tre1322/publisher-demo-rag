# popular-network-demo — production environment template
#
# Copy this to `.env` on the droplet at /opt/publisher-demo-rag/popular-network-demo/.env
# Compose reads it via `env_file:` directive in /opt/amplafai/docker-compose.yml.
#
# DO NOT commit the populated .env to git.

# ── Required ───────────────────────────────────────────────────────────
# Claude API key (reuse the one from /opt/amplafai/.env — same Anthropic org)
ANTHROPIC_API_KEY=sk-ant-...

# ── Production hardening (set exactly these for prod) ──────────────────
# Turns off /widget-test.html and any dev-only routes (per H.1 gating)
ENVIRONMENT=production

# Forces uvicorn to bind the container's external interface
HOST=0.0.0.0
PORT=8080

# Session cookie becomes Secure (HTTPS-only) — required behind Caddy TLS
POPULAR_COOKIE_SECURE=1

# Used in invite emails so the claim link points at the live host
APP_BASE_URL=https://dashboard.amplafai.com

# Where SQLite lives inside the container (mounted as named volume)
POPULAR_DB_PATH=/app/data/popular_network.db

# ── Invite email delivery (Postmark) ───────────────────────────────────
# Without these set, invites still mint, but no email is sent — they
# only return the URL for manual copy/paste. Set for production.
POSTMARK_API_KEY=
INVITE_FROM_EMAIL=invites@amplafai.com
INVITE_FROM_NAME=Amplafai
POSTMARK_MESSAGE_STREAM=outbound
