# Off-server backup target for deploy/backup-dashboard.sh (Phase 1).
# Copy to /opt/amplafai/backups/spaces.env on the droplet, fill in, then:
#   chmod 600 /opt/amplafai/backups/spaces.env
# Create the key in DigitalOcean (Spaces Object Storage → Access Keys),
# limited to this bucket if possible.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=amplafai-backups
SPACES_REGION=nyc3
# Folder inside the bucket (default "dashboard"). Copies older than
# SPACES_KEEP_DAYS (default: the script's KEEP_DAYS, 30) are deleted.
SPACES_PREFIX=dashboard
