# Caddy auto-provisions + renews a Let's Encrypt cert for each hostname.
# Requires: A-record for each hostname -> droplet IP, Cloudflare proxy
# OFF (grey cloud / DNS only), and ports 80 + 443 open on the droplet.
{
        email windomnews@gmail.com
}

app.amplafai.com {
        encode zstd gzip
        reverse_proxy web:8080
}

dashboard.amplafai.com {
        encode zstd gzip
        # Access log (Phase 1), so an incident like "was anything downloaded?"
        # can be answered. Cookie/Authorization values are blanked by Caddy's
        # default; one-time ?token= values (reset + invite links) are redacted.
        log {
                output file /data/dashboard-access.log {
                        roll_size 50MiB
                        roll_keep 14
                        roll_keep_for 720h
                }
                format filter {
                        wrap json
                        fields {
                                request>uri query {
                                        replace token REDACTED
                                }
                        }
                }
        }
        reverse_proxy dashboard:8080
}
